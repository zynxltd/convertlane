APP_NAME=ConvertLane
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://network.test
# Public URL for emails and absolute links (production: https://convertlane.co.uk)
APP_PUBLIC_URL=https://convertlane.co.uk

# Production: set APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=error

# Brand
BRAND_CONTACT_EMAIL=contact@convertlane.co.uk
BRAND_EMAIL=contact@convertlane.co.uk
LEGAL_EMAIL=contact@convertlane.co.uk
LEGAL_PRIVACY_EMAIL=contact@convertlane.co.uk
BRAND_PHONE=
BRAND_SHOW_TEAM=false

# Offer18 network platform (convertlane.offer18.com)
PARTNER_PANEL_URL=https://convertlane.offer18.com
ADVERTISER_PANEL_URL=https://convertlane.offer18.com/m
OFFER18_API_BASE=https://api.offer18.com
OFFER18_MID=
OFFER18_API_KEY=
OFFER18_SECRET_KEY=

# Offers CMS (/admin/offers?key=...)
CMS_ACCESS_KEY=

# Internal compliance portal (/compliance?key=...)
COMPLIANCE_ACCESS_KEY=

# Affise API (internal ops only — not shown on the website)
AFFISE_API_URL=https://api.affise.com
AFFISE_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=convertlane
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local: MAIL_MAILER=log writes to storage/logs only. Production: use postmark (see Postmark server API token).
MAIL_MAILER=postmark
POSTMARK_API_KEY=
# Optional: Postmark message stream (default outbound if omitted)
# POSTMARK_MESSAGE_STREAM_ID=outbound
MAIL_FROM_ADDRESS=partners@convertlane.co.uk
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
